#!/usr/bin/env python3
"""
HandGestureRecongizer.py

Description:
    This node is used to detect hand gestures using mediapipe model.

Author:
    Amirhossein Soltani

Created:
    2025-06-27

"""

import cv2
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import numpy as np
import rospy
from cv_bridge import CvBridge, CvBridgeError
from std_msgs.msg import String
from sensor_msgs.msg import Image


class GestureRecognition():
    def __init__(self, debug_mode=True):
        
        self.cvbridge = CvBridge()
        self.debug = debug_mode
        self.pub_debug = rospy.Publisher("/mir_perception/gesture_recognition/output/gesture_recognition_debug", Image, queue_size=1)

        rospy.Subscriber("/mir_perception/gesture_recognition/event_in", String, self.event_in_cb)
        self.event_out = rospy.Publisher("/mir_perception/gesture_recognition/event_out", String, queue_size=1)

        # mediapipe model config
        base_options = python.BaseOptions(model_asset_path='/home/robocup/ros/noetic/robocup/src/mas_industrial_robotics/mir_perception/mir_object_recognition/ros/model/gesture_recognizer.task')
        options = vision.GestureRecognizerOptions(base_options=base_options)
        self.recognizer = vision.GestureRecognizer.create_from_options(options)
            
            
        self.event = None
        self.gesture_sent = False
        self.frame_counter = 0
     
    # Function to add text on the frame
    # @staticmethod
    def add_text_with_background(self, frame, text, position=None, font=cv2.FONT_HERSHEY_SIMPLEX,
                                font_scale=1.0, text_color=(0, 255, 0), bg_color=(0, 0, 0),
                                thickness=2, padding=10, alpha=0.7):
        """
        Add text with a semi-transparent background for better visibility
        """
        if position is None:
            # Auto-position at top-left with margin
            position = (20, 40)
        # Get text size
        (text_width, text_height), baseline = cv2.getTextSize(text, font, font_scale, thickness)
        # Calculate background rectangle coordinates
        x, y = position
        rect_start = (x - padding, y - text_height - padding)
        rect_end = (x + text_width + padding, y + baseline + padding)
        # Create overlay for semi-transparent background
        overlay = frame.copy()
        cv2.rectangle(overlay, rect_start, rect_end, bg_color, -1)
        # Apply the overlay with transparency
        cv2.addWeighted(overlay, alpha, frame, 1 - alpha, 0, frame)
        # Add the text on top
        cv2.putText(frame, text, position, font, font_scale, text_color, thickness)
        return frame
    
    def add_status_overlay(self, frame, gesture, frame_count=None):
        """
        Add a comprehensive status overlay to the frame
        """
        height, width = frame.shape[:2]
        # Status information
        status_lines = [
            f"Gesture: {gesture if gesture else 'None'}"
        ]
        # Add each line with different colors
        colors = [(0, 255, 0), (255, 255, 0), (0, 255, 255), (255, 0, 255)]
        for i, (line, color) in enumerate(zip(status_lines, colors)):
            y_pos = 40 + i * 35
            frame = self.add_text_with_background(
                frame, line,
                position=(20, y_pos),
                font=cv2.FONT_HERSHEY_SIMPLEX,
                font_scale=0.7,
                text_color=color,
                bg_color=(0, 0, 0),
                thickness=2,
                padding=8,
                alpha=0.6
            )
        # Add progress bar for thumb up detection
        if gesture and gesture.upper() == "THUMB_DOWN":
            progress = min(self.frame_counter / 5.0, 1.0)
            bar_width = 200
            bar_height = 20
            bar_x = width - bar_width - 20
            bar_y = 30
            # Background bar
            cv2.rectangle(frame, (bar_x, bar_y), (bar_x + bar_width, bar_y + bar_height), (50, 50, 50), -1)
            # Progress bar
            progress_width = int(bar_width * progress)
            bar_color = (0, 255, 0) if progress == 1.0 else (0, 255, 255)
            cv2.rectangle(frame, (bar_x, bar_y), (bar_x + progress_width, bar_y + bar_height), bar_color, -1)
            # Progress text
            cv2.putText(frame, f"{int(progress * 100)}%", (bar_x + 10, bar_y + 15),
                       cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
        return frame
    
    def callback(self, img_msg):
        rospy.loginfo("[gesture_recognition_node] Received image message in callback")
        try:
            self.run(img_msg)
        except Exception as e:
            rospy.loginfo("[hand_gesture_node] killing callback")

    def event_in_cb(self, msg):
        """ 
        Starts a planned motion based on the specified arm position.
        """
        self.event = msg.data
        if self.event.startswith("e_start") and not self.gesture_sent:
            self.sub_img = rospy.Subscriber("/tower_cam3d_front/color/image_raw", Image, self.callback)
        if self.gesture_sent:
            self.sub_img.sub.unregister()

    def mediapipe_detect(self, cv_img):
        """ 
        Detects hand gestures using mediapipe model
        """
        imgRGB = cv2.cvtColor(cv_img, cv2.COLOR_BGR2RGB)
        mp_RGB_frame = mp.Image(image_format=mp.ImageFormat.SRGB, data=imgRGB)
        recognition_result = self.recognizer.recognize(mp_RGB_frame)
        if recognition_result.gestures:
            print(recognition_result.gestures)
            top_gesture = recognition_result.gestures[0][0].category_name
        else:
            top_gesture = None
        
        return top_gesture
    
    def run(self, image):
        """
        image: image data of current frame with Image data type
        """
        if image:
            try:
                cv_img = self.cvbridge.imgmsg_to_cv2(image, "bgr8")
                top_gesture = self.mediapipe_detect(cv_img)
                rospy.logwarn("[###################_DETECTED_###################] Detected gesture in run():: %s", top_gesture)
                if top_gesture.upper() == "THUMB_UP":
                    self.frame_counter += 1
                    if self.frame_counter >= 5:
                        msg_str = f'e_done'
                        self.event_out.publish(String(data=msg_str))
                        self.gesture_sent = True
                        # print("gesture e_done sent")
                else:
                    rospy.loginfo("[gesture_recognition_node] Gesture not recognized or not THUMB_UP")
                    self.frame_counter = 0

                if self.debug:
                    # Add the detected gesture to the frame
                    # cv_img_edit = self.add_text(cv_img, text=f"Detected gesture: {top_gesture}", position=(50, 50), fontFace=cv2.FONT_HERSHEY_SIMPLEX, fontScale=1, color=(0, 0, 255), thickness=2)
                    cv_img = self.add_status_overlay(cv_img, top_gesture)
                    self.publish_debug_img(cv_img)

            except CvBridgeError as e:
                rospy.logerr(e)
                return
        else:
            rospy.logwarn("No image received") 

    def publish_debug_img(self, debug_img):
        # debug_img = np.array(debug_img, dtype=np.uint8)
        debug_img = self.cvbridge.cv2_to_imgmsg(debug_img, "bgr8")
        self.pub_debug.publish(debug_img)


if __name__ == '__main__':
    rospy.init_node("gesture_recognition")
    rospy.loginfo('Started Gesture Recognition Node.')
    object_recognizer = GestureRecognition(debug_mode=True)
    rospy.loginfo("Gesture Recognition node is ready to recognize gesture")
    rospy.spin()